{
    "name": "@itscark/shadcn-lint-blade",
    "version": "0.2.0",
    "description": "An ESLint parser that lets @shadcn/lint lint Laravel Blade and Livewire views.",
    "keywords": [
        "eslint",
        "eslint-parser",
        "shadcn",
        "blade",
        "laravel",
        "livewire",
        "flux",
        "tailwindcss"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/itscark/shadcn-lint-blade.git"
    },
    "type": "module",
    "exports": {
        ".": "./src/parser.mjs",
        "./components": "./src/components.mjs"
    },
    "files": [
        "src"
    ],
    "scripts": {
        "test": "node --test"
    },
    "release": {
        "branches": [
            "main"
        ],
        "plugins": [
            "@semantic-release/commit-analyzer",
            "@semantic-release/release-notes-generator",
            [
                "@semantic-release/npm",
                {
                    "npmPublish": false
                }
            ],
            [
                "@semantic-release/exec",
                {
                    "prepareCmd": "sed -i -E 's/(shadcn-lint-blade#v)[0-9]+\\.[0-9]+\\.[0-9]+/\\1${nextRelease.version}/' README.md"
                }
            ],
            [
                "@semantic-release/git",
                {
                    "assets": [
                        "package.json",
                        "package-lock.json",
                        "README.md"
                    ]
                }
            ],
            "@semantic-release/github"
        ]
    },
    "dependencies": {
        "espree": "^11.2.0"
    },
    "peerDependencies": {
        "@shadcn/lint": ">=0.2.3",
        "eslint": ">=9.30.0"
    },
    "devDependencies": {
        "@shadcn/lint": "^0.2.3",
        "eslint": "^10.13.0"
    },
    "engines": {
        "node": ">=20.19"
    }
}
